{"metadata": {"availableLanguages": ["de-DE", "en-US", "es-419", "fr-FR", "it-IT", "ja-JP", "ko-KR", "pt-BR", "zh-CN"], "role": "article", "roleHeading": "Article", "title": "iOS & iPadOS 27.2 Beta 4 Release Notes"}, "primaryContentSections": [{"content": [{"anchor": "Overview", "level": 2, "text": "Overview", "type": "heading"}, {"inlineContent": [{"text": "The iOS & iPadOS 27.2 SDK provides support to develop apps for iPhone and iPad running iOS & iPadOS 27.2 beta 4. The SDK comes bundled with Xcode 27.2. For information on the compatibility requirements for Xcode 27.2, see ", "type": "text"}, {"identifier": "/documentation/Xcode-Release-Notes/xcode-27_2-release-notes", "isActive": true, "type": "reference"}, {"text": ".", "type": "text"}], "type": "paragraph"}, {"anchor": "App-Tracking-Transparency", "level": 3, "text": "App Tracking Transparency", "type": "heading"}, {"anchor": "New-Features", "level": 4, "text": "New Features", "type": "heading"}, {"items": [{"content": [{"inlineContent": [{"code": "AppTrackingTransparency", "type": "codeVoice"}, {"text": " (", "type": "text"}, {"identifier": "https://developer.apple.com/documentation/apptrackingtransparency", "isActive": true, "type": "reference"}, {"text": ") now supports an alternative expanded prompt and re-prompting on a yearly basis for EU users. The alternative prompt is required for users in France, Germany, Italy, Poland, and Romania.", "type": "text"}, {"text": " ", "type": "text"}, {"text": "(179504171)", "type": "text"}], "type": "paragraph"}]}], "type": "unorderedList"}, {"anchor": "Resolved-Issues", "level": 4, "text": "Resolved Issues", "type": "heading"}, {"items": [{"content": [{"inlineContent": [{"text": "Fixed: The new ", "type": "text"}, {"code": "requestTrackingAuthorization(usingExpandedInterface:additionalInformationAction:completionHandler:)", "type": "codeVoice"}, {"text": " API is renamed to ", "type": "text"}, {"code": "requestTrackingAuthorization(preferExpandedInterface:...)", "type": "codeVoice"}, {"text": ".", "type": "text"}, {"text": " ", "type": "text"}, {"text": "(187149729)", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "Fixed: The new ", "type": "text"}, {"code": "requestTrackingAuthorization(preferExpandedInterface:...)", "type": "codeVoice"}, {"text": " API is renamed to ", "type": "text"}, {"code": "requestTrackingAuthorizationPreferringExpandedInterface:…)", "type": "codeVoice"}, {"text": ".", "type": "text"}, {"text": " ", "type": "text"}, {"text": "(187610745)", "type": "text"}], "type": "paragraph"}]}], "type": "unorderedList"}, {"anchor": "Health", "level": 3, "text": "Health", "type": "heading"}, {"anchor": "Known-Issues", "level": 4, "text": "Known Issues", "type": "heading"}, {"items": [{"content": [{"inlineContent": [{"text": "Personalized summaries may not generate as expected in the Insights tab.", "type": "text"}, {"text": " ", "type": "text"}, {"text": "(186964423)", "type": "text"}], "type": "paragraph"}]}, {"content": [{"inlineContent": [{"text": "The redesigned Health app is not included in this beta and was available in the previous beta for testing purposes only. If you update to this beta, your Health app data from the previous beta remains on your device and is viewable in Settings. The redesigned Health app will be available again in an upcoming iOS beta.", "type": "text"}, {"text": " ", "type": "text"}, {"text": "(188843443)", "type": "text"}], "type": "paragraph"}]}], "type": "unorderedList"}], "kind": "content"}]}